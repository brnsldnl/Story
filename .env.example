# PDKS - ortam değişkenleri
# Bu dosyayı .env olarak kopyalayıp değerleri doldurun. .env ASLA
# versiyon kontrolüne eklenmez.

POSTGRES_PASSWORD=guclu-bir-parola-yazin

# En az 32 bayt olmalı; uygulama kısasını reddeder.
#   openssl rand -base64 48
JWT_SECRET=

# Terminal QR anahtarları bundan TÜRETİLİR, veritabaninda saklanmaz.
# Değiştirilirse tüm terminallerin yeniden kurulumu gerekir.
QR_MASTER_SECRET=
# Okutma yalnızca kayıtlı cihazdan yapılabilsin mi?
QR_REQUIRE_REGISTERED_DEVICE=true

# KVKK: fotoğrafların saklama süresi (gün).
# Süre dolduğunda dosyalar otomatik ve gerçekten silinir.
PHOTO_RETENTION_DAYS=60

# --- Logo Tiger entegrasyonu ---
# Okuma: MSSQL, SALT OKUNUR kullanıcı ile
LOGO_SYNC_ENABLED=false
LOGO_MSSQL_DSN=DRIVER={FreeTDS};SERVER=logo-sunucu;PORT=1433;DATABASE=LOGODB;UID=pdks_read;PWD=;TDS_Version=7.4

# Yazma: yalnızca Tiger Objects REST üzerinden (bordroya geçildiğinde)
LOGO_REST_BASE_URL=
LOGO_REST_CLIENT_ID=
LOGO_REST_CLIENT_SECRET=
LOGO_REST_FIRM_NUMBER=1
